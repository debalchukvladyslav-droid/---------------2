# Copy to .env.test.local. Never commit the local file.
TEST_SUPABASE_URL=https://your-staging-project.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# The seed script refuses to run unless this explicit safety switch is present.
TEST_ALLOW_SEED=true

# Replace before sharing the staging environment with another person.
TEST_TRADER_PASSWORD=ChangeMe-Test-Trader-2026!
TEST_MENTOR_PASSWORD=ChangeMe-Test-Mentor-2026!
TEST_ADMIN_PASSWORD=ChangeMe-Test-Admin-2026!
